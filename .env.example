# Local: copy to .env. Railway: set these on the service (Variables tab).

# Railway: reference the Postgres service, i.e. DATABASE_URL=${{Postgres.DATABASE_URL}} (private network, no TLS).
# Set DATABASE_SSL=true only if you point this at the public proxy URL instead.
DATABASE_URL=postgres://localhost:5432/switchboard_dev
# DATABASE_SSL=true

# One key per site, comma-separated: <site code>=<key>. Use opaque codes (s1, s2…), never brand
# names: the code is what the database stores. The key decides which site a row is filed under, so a
# leaked key can only add rows for its own site. Generate each with `npm run key`; the same key goes
# into that site's SWITCHBOARD_API_KEY.
SITE_KEYS=s1=replace-with-npm-run-key,s2=replace-with-npm-run-key,s3=replace-with-npm-run-key,s4=replace-with-npm-run-key

# Optional display names for the codes, shown only to signed-in dashboard users and never stored with a
# submission. Leave unset and the dashboard shows the codes. No commas inside a name.
# SITE_LABELS="s1=Dr. Vigor,s2=Dr. Neo,s3=Dr. Sculpt,s4=Dr. Food"

# Shared password for the internal dashboard (12+ characters).
DASHBOARD_PASSWORD=
# Signs dashboard sessions (32+ characters, `npm run key`). Changing it signs everyone out.
SESSION_SECRET=
# SESSION_HOURS=8

# Encrypts emails at rest (AES-256-GCM), 64 hex characters: `npm run key`. Losing or changing it makes
# every stored email unreadable, so keep it with the other production secrets.
DATA_KEY=

# Emails are removed from leads older than this many days; the date and traffic source stay for reporting.
# RETENTION_DAYS=90

# Exact origin(s) of the dashboard, comma-separated, no trailing slash.
DASHBOARD_ORIGINS=http://localhost:5174

# Railway sets PORT itself. Local default 4300.
# PORT=4300
